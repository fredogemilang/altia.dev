---
import Layout from '../../../layouts/Layout.astro';
import { Container } from '../../../components/ui/Container';
import { Badge } from '../../../components/ui/Badge';
import { Card } from '../../../components/ui/Card';
import { Button } from '../../../components/ui/Button';
import { getBlogPosts } from '../../../lib/b10cks';
import { t, type Locale, getLocalizedPath } from '../../../i18n/utils';
import { Sparkles, Clock, ArrowUpRight } from 'lucide-react';

const locale: Locale = 'id';
const posts = await getBlogPosts();
---

<Layout title={t(locale, 'Blog.title')} locale={locale}>
  <div class="flex flex-col gap-16 pb-24">
    <!-- 1. Header -->
    <section class="pt-12 pb-8 bg-noise border-b border-warm-border/60">
      <Container size="large">
        <div class="max-w-3xl">
          <Badge
            variant="vermilion"
            size="md"
            className="mb-4 uppercase tracking-widest text-[11px] font-bold"
          >
            <Sparkles className="w-3.5 h-3.5 text-vermilion" />
            <span>{t(locale, 'Blog.tag')}</span>
          </Badge>
          <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight text-charcoal leading-[1.12] mb-6">
            {t(locale, 'Blog.title')}
          </h1>
          <p class="text-lg sm:text-xl text-charcoal-muted leading-relaxed">
            {t(locale, 'Blog.subtitle')}
          </p>
        </div>
      </Container>
    </section>

    <!-- 2. Blog Posts Grid -->
    <section>
      <Container size="large">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {posts.map((post) => (
            <Card
              key={post.slug}
              className="flex flex-col justify-between h-full bg-warm-card border-warm-border group hover:border-vermilion"
            >
              <div>
                <div class="aspect-[16/10] w-full rounded-2xl bg-cream overflow-hidden mb-6 relative">
                  <img
                    src={post.coverImage}
                    alt={post.title[locale]}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>

                <div class="flex items-center justify-between gap-2 mb-3">
                  <Badge variant="vermilion" size="sm" className="uppercase font-bold tracking-wider">
                    {post.category}
                  </Badge>
                  <div class="flex items-center gap-1.5 text-xs text-charcoal-muted">
                    <Clock className="w-3.5 h-3.5 text-vermilion" />
                    <span>{post.readTime} {t(locale, 'Blog.readTime')}</span>
                  </div>
                </div>

                <h3 class="font-display text-2xl font-bold text-charcoal mb-3 group-hover:text-vermilion transition-colors">
                  {post.title[locale]}
                </h3>

                <p class="text-sm text-charcoal-muted leading-relaxed mb-6">
                  {post.excerpt[locale]}
                </p>
              </div>

              <div class="pt-4 border-t border-warm-border flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full overflow-hidden">
                    <img
                      src={post.author.avatar}
                      alt={post.author.name}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <span class="text-xs font-display font-medium text-charcoal">
                    {post.author.name}
                  </span>
                </div>

                <Button
                  href={getLocalizedPath(`/blog/${post.slug}`, locale)}
                  variant="ghost"
                  size="sm"
                  className="text-vermilion font-bold p-0 hover:bg-transparent"
                  cursorText="READ"
                >
                  <span>{t(locale, 'Blog.readMore')}</span>
                  <ArrowUpRight className="w-4 h-4" />
                </Button>
              </div>
            </Card>
          ))}
        </div>
      </Container>
    </section>
  </div>
</Layout>
