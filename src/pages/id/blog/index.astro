---
import Layout from '../../../layouts/Layout.astro';
import { Container } from '../../../components/ui/Container';
import { Badge } from '../../../components/ui/Badge';
import { FilterableBlogGrid } from '../../../components/blog/FilterableBlogGrid';
import { getBlogPosts } from '../../../lib/b10cks';
import { t, type Locale } from '../../../i18n/utils';
import { Sparkles } from 'lucide-react';

const locale: Locale = 'id';
const posts = await getBlogPosts();
---

<Layout title={t(locale, 'Blog.title')} locale={locale}>
  <div class="flex flex-col gap-16 pb-36 sm:pb-44 lg:pb-52">
    <!-- 1. Header (Faded Grid Overlay & Warm Shaded Gradient) -->
    <section class="relative pt-16 sm:pt-20 pb-12 sm:pb-16 overflow-hidden bg-gradient-to-b from-[#FFFDF9] via-ivory to-[#EDE3D2] border-b border-warm-border/60">
      {/* Seamless Faded Background Grid with Ambient Radial Glow */}
      <div class="hero-grid-faded" />
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-vermilion/5 rounded-full blur-3xl pointer-events-none" />

      <Container size="large" className="relative z-10">
        <div class="max-w-3xl">
          <Badge
            variant="vermilion"
            size="md"
            className="mb-4 uppercase tracking-widest text-[11px] font-bold"
          >
            <Sparkles className="w-3.5 h-3.5 text-vermilion" />
            <span>{t(locale, 'Blog.tag')}</span>
          </Badge>
          <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight text-charcoal leading-[1.12] mb-6">
            {t(locale, 'Blog.title')}
          </h1>
          <p class="text-lg sm:text-xl text-charcoal-muted leading-relaxed">
            {t(locale, 'Blog.subtitle')}
          </p>
        </div>
      </Container>
    </section>

    <!-- 2. Blog Posts Grid with Pillar Filter -->
    <section>
      <Container size="large">
        <FilterableBlogGrid client:load posts={posts} locale={locale} />
      </Container>
    </section>
  </div>
</Layout>
