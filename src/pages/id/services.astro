---
import Layout from '../../layouts/Layout.astro';
import { Container } from '../../components/ui/Container';
import { Button } from '../../components/ui/Button';
import { Badge } from '../../components/ui/Badge';
import { SectionHeading } from '../../components/ui/SectionHeading';
import { ScrollReveal } from '../../components/effects/ScrollReveal';
import { ProcessStepsGrid, type ProcessStep } from '../../components/sections/services/ProcessStepsGrid';
import { EngineeringStandardsBento, type BentoCardData } from '../../components/sections/services/EngineeringStandardsBento';
import { t, type Locale, getLocalizedPath } from '../../i18n/utils';
import {
  Globe,
  Smartphone,
  Cpu,
  CheckCircle2,
  ArrowRight,
  Sparkles,
} from 'lucide-react';

const locale: Locale = 'id';

const processSteps: ProcessStep[] = [
  {
    number: '01',
    title: t(locale, 'Services.process.steps.0.title'),
    desc: t(locale, 'Services.process.steps.0.desc'),
  },
  {
    number: '02',
    title: t(locale, 'Services.process.steps.1.title'),
    desc: t(locale, 'Services.process.steps.1.desc'),
  },
  {
    number: '03',
    title: t(locale, 'Services.process.steps.2.title'),
    desc: t(locale, 'Services.process.steps.2.desc'),
  },
  {
    number: '04',
    title: t(locale, 'Services.process.steps.3.title'),
    desc: t(locale, 'Services.process.steps.3.desc'),
  },
];

const standardsCard1: BentoCardData = {
  tag: t(locale, 'Services.standards.card1.tag'),
  title: t(locale, 'Services.standards.card1.title'),
  desc: t(locale, 'Services.standards.card1.desc'),
  badge: t(locale, 'Services.standards.card1.badge'),
};

const standardsCard2: BentoCardData = {
  tag: t(locale, 'Services.standards.card2.tag'),
  title: t(locale, 'Services.standards.card2.title'),
  desc: t(locale, 'Services.standards.card2.desc'),
  badge: t(locale, 'Services.standards.card2.badge'),
};

const standardsCard3: BentoCardData = {
  tag: t(locale, 'Services.standards.card3.tag'),
  title: t(locale, 'Services.standards.card3.title'),
  desc: t(locale, 'Services.standards.card3.desc'),
  badge: t(locale, 'Services.standards.card3.badge'),
};

const standardsCard4: BentoCardData = {
  tag: t(locale, 'Services.standards.card4.tag'),
  title: t(locale, 'Services.standards.card4.title'),
  desc: t(locale, 'Services.standards.card4.desc'),
  badge: t(locale, 'Services.standards.card4.badge'),
};
---

<Layout title={t(locale, 'Services.title')} locale={locale}>
  <div class="flex flex-col gap-24 sm:gap-32 pb-36 sm:pb-44 lg:pb-52">
    <!-- 1. HERO HEADER (Faded Grid Overlay & Warm Shaded Gradient) -->
    <section class="relative pt-16 sm:pt-20 pb-12 sm:pb-16 overflow-hidden bg-gradient-to-b from-[#FFFDF9] via-ivory to-[#EDE3D2] border-b border-warm-border/60">
      {/* Seamless Faded Background Grid with Ambient Radial Glow */}
      <div class="hero-grid-faded" />
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-vermilion/5 rounded-full blur-3xl pointer-events-none" />

      <Container size="large" className="relative z-10">
        <div class="max-w-3xl">
          <Badge variant="vermilion" size="md" className="mb-4 uppercase tracking-widest text-[11px] font-bold">
            <Sparkles className="w-3.5 h-3.5 text-vermilion" />
            <span>{t(locale, 'Services.tag')}</span>
          </Badge>
          <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight text-charcoal leading-[1.12] mb-6">
            {t(locale, 'Services.title')}
          </h1>
          <p class="text-lg sm:text-xl text-charcoal-muted leading-relaxed">
            {t(locale, 'Services.subtitle')}
          </p>
        </div>
      </Container>
    </section>

    <!-- 2. THREE CORE SERVICES DEEP DIVE -->
    <section class="flex flex-col gap-20 sm:gap-28">
      <!-- Service 01: Web Development -->
      <div id="web" class="scroll-mt-32">
        <Container size="large">
          <ScrollReveal client:visible variant="fade-up">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-cream/40 rounded-4xl p-8 sm:p-12 lg:p-16 border border-warm-border">
              <div class="lg:col-span-7 flex flex-col gap-6">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-2xl bg-vermilion text-ivory flex items-center justify-center font-display font-bold">
                    <Globe className="w-6 h-6" />
                  </div>
                  <span class="font-display font-black text-3xl text-vermilion">
                    {t(locale, 'Services.items.web.number')}
                  </span>
                </div>

                <h2 class="font-display text-3xl sm:text-4xl font-bold text-charcoal">
                  {t(locale, 'Services.items.web.title')}
                </h2>

                <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed">
                  {t(locale, 'Services.items.web.description')}
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Corporate websites & headless CMS</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Laravel, Symfony, Next.js, Astro & React</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>High-throughput API & backend services</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>PostgreSQL, MySQL, Redis & Docker</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Caching, CDN & performance optimization</span>
                  </div>
                </div>

                <div class="pt-4 flex flex-wrap gap-2 items-center">
                  <span class="text-xs font-display font-bold uppercase text-charcoal-muted mr-2">
                    Stack:
                  </span>
                  {['WordPress', 'Laravel', 'Next.js', 'Astro', 'Go', 'PostgreSQL', 'Docker'].map((tech) => (
                    <Badge key={tech} variant="cream" size="sm">
                      {tech}
                    </Badge>
                  ))}
                </div>

                <div class="pt-4">
                  <Button href={getLocalizedPath('/contact', locale)} variant="primary" size="md">
                    <span>{t(locale, 'Services.items.web.cta')}</span>
                    <ArrowRight className="w-4 h-4" />
                  </Button>
                </div>
              </div>

              <div class="lg:col-span-5">
                <div class="bg-charcoal text-ivory rounded-3xl p-6 sm:p-8 font-mono text-xs shadow-warm-lg">
                  <div class="flex items-center justify-between pb-4 mb-4 border-b border-charcoal-500/40">
                    <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded-full bg-vermilion" />
                      <div class="w-3 h-3 rounded-full bg-terracotta" />
                      <div class="w-3 h-3 rounded-full bg-warm-border/40" />
                    </div>
                    <span class="text-[10px] text-ivory/50">polyglot-cluster.config.ts</span>
                  </div>
                  <pre class="text-ivory/80 overflow-x-auto leading-relaxed">
                    <code>{`export const enterpriseCluster = {
  apiGateways: "Go (Fiber) + Rust (Actix/Axum)",
  frontendLayer: "Next.js 14 + Astro (Edge SSR)",
  enterpriseCore: "Laravel 11 + Filament (PHP 8.3)",
  wasmCompute: "Rust WebAssembly in-browser",
  storageLayer: {
    primary: "PostgreSQL / MySQL with Sharding",
    cache: "Redis Cluster (< 2ms response)",
    olap: "ClickHouse Real-Time Analytics"
  },
  devops: "Docker + Kubernetes + CI/CD"
};`}</code>
                  </pre>
                </div>
              </div>
            </div>
          </ScrollReveal>
        </Container>
      </div>

      <!-- Service 02: Mobile & Desktop Apps -->
      <div id="app" class="scroll-mt-32">
        <Container size="large">
          <ScrollReveal client:visible variant="fade-up">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-cream/40 rounded-4xl p-8 sm:p-12 lg:p-16 border border-warm-border">
              <div class="lg:col-span-7 flex flex-col gap-6">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-2xl bg-vermilion text-ivory flex items-center justify-center font-display font-bold">
                    <Smartphone className="w-6 h-6" />
                  </div>
                  <span class="font-display font-black text-3xl text-vermilion">
                    {t(locale, 'Services.items.app.number')}
                  </span>
                </div>

                <h2 class="font-display text-3xl sm:text-4xl font-bold text-charcoal">
                  {t(locale, 'Services.items.app.title')}
                </h2>

                <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed">
                  {t(locale, 'Services.items.app.description')}
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Flutter & React Native</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>macOS & Windows utilities</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Offline-first architecture</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>SQLite & synchronization</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Native APIs & device integrations</span>
                  </div>
                </div>

                <div class="pt-4 flex flex-wrap gap-2 items-center">
                  <span class="text-xs font-display font-bold uppercase text-charcoal-muted mr-2">
                    Stack:
                  </span>
                  {['Flutter', 'React Native', 'Rust', 'Electron', 'SQLite'].map((tech) => (
                    <Badge key={tech} variant="cream" size="sm">
                      {tech}
                    </Badge>
                  ))}
                </div>

                <div class="pt-4">
                  <Button href={getLocalizedPath('/contact', locale)} variant="primary" size="md">
                    <span>{t(locale, 'Services.items.app.cta')}</span>
                    <ArrowRight className="w-4 h-4" />
                  </Button>
                </div>
              </div>

              <div class="lg:col-span-5">
                <div class="bg-charcoal text-ivory rounded-3xl p-6 sm:p-8 font-mono text-xs shadow-warm-lg">
                  <div class="flex items-center justify-between pb-4 mb-4 border-b border-charcoal-500/40">
                    <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded-full bg-vermilion" />
                      <div class="w-3 h-3 rounded-full bg-terracotta" />
                      <div class="w-3 h-3 rounded-full bg-warm-border/40" />
                    </div>
                    <span class="text-[10px] text-ivory/50">app-runtime.dart</span>
                  </div>
                  <pre class="text-ivory/80 overflow-x-auto leading-relaxed">
                    <code>{`class AltiaAppEngine {
  final MultiPlatformRuntime platform;
  final LocalStorageCache cache;

  Future<void> initialize() async {
    await cache.syncOfflineDatabase();
    platform.enableNative60fpsIsolates();
    print("Multi-platform ready on iOS & macOS");
  }
}`}</code>
                  </pre>
                </div>
              </div>
            </div>
          </ScrollReveal>
        </Container>
      </div>

      <!-- Service 03: AI Automation -->
      <div id="ai" class="scroll-mt-32">
        <Container size="large">
          <ScrollReveal client:visible variant="fade-up">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-cream/40 rounded-4xl p-8 sm:p-12 lg:p-16 border border-warm-border">
              <div class="lg:col-span-7 flex flex-col gap-6">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-2xl bg-vermilion text-ivory flex items-center justify-center font-display font-bold">
                    <Cpu className="w-6 h-6" />
                  </div>
                  <span class="font-display font-black text-3xl text-vermilion">
                    {t(locale, 'Services.items.ai.number')}
                  </span>
                </div>

                <h2 class="font-display text-3xl sm:text-4xl font-bold text-charcoal">
                  {t(locale, 'Services.items.ai.title')}
                </h2>

                <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed">
                  {t(locale, 'Services.items.ai.description')}
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Multi-agent systems</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Enterprise RAG & hybrid search</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Document & PDF processing</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>AI agents & tool calling</span>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-charcoal font-medium">
                    <CheckCircle2 className="w-4 h-4 text-vermilion flex-shrink-0" />
                    <span>Guardrails, evaluation & monitoring</span>
                  </div>
                </div>

                <div class="pt-4 flex flex-wrap gap-2 items-center">
                  <span class="text-xs font-display font-bold uppercase text-charcoal-muted mr-2">
                    Stack:
                  </span>
                  {['Python', 'LangChain', 'FastAPI', 'Qdrant', 'LLM APIs'].map((tech) => (
                    <Badge key={tech} variant="cream" size="sm">
                      {tech}
                    </Badge>
                  ))}
                </div>

                <div class="pt-4">
                  <Button href={getLocalizedPath('/contact', locale)} variant="primary" size="md">
                    <span>{t(locale, 'Services.items.ai.cta')}</span>
                    <ArrowRight className="w-4 h-4" />
                  </Button>
                </div>
              </div>

              <div class="lg:col-span-5">
                <div class="bg-charcoal text-ivory rounded-3xl p-6 sm:p-8 font-mono text-xs shadow-warm-lg">
                  <div class="flex items-center justify-between pb-4 mb-4 border-b border-charcoal-500/40">
                    <div class="flex items-center gap-2">
                      <div class="w-3 h-3 rounded-full bg-vermilion" />
                      <div class="w-3 h-3 rounded-full bg-terracotta" />
                      <div class="w-3 h-3 rounded-full bg-warm-border/40" />
                    </div>
                    <span class="text-[10px] text-ivory/50">agent-graph.py</span>
                  </div>
                  <pre class="text-ivory/80 overflow-x-auto leading-relaxed">
                    <code>{`from langgraph.graph import StateGraph

workflow = StateGraph(AgentState)
workflow.add_node("router", query_classifier)
workflow.add_node("retriever", hybrid_rag_search)
workflow.add_node("auditor", hallucination_guard)
workflow.add_edge("retriever", "auditor")

app = workflow.compile()
print("AI Agent Graph online with 99.4% precision")`}</code>
                  </pre>
                </div>
              </div>
            </div>
          </ScrollReveal>
        </Container>
      </div>
    </section>

    <!-- 3. AGILE METHODOLOGY & PROCESS -->
    <section class="py-16 sm:py-20 bg-charcoal text-ivory rounded-4xl my-4 mx-4 sm:mx-8 lg:mx-12 overflow-hidden shadow-warm-lg">
      <Container size="large">
        <SectionHeading
          client:visible
          tag={t(locale, 'Services.process.tag')}
          title={t(locale, 'Services.process.title')}
          dark
        />

        <ProcessStepsGrid client:visible steps={processSteps} />
      </Container>
    </section>

    <!-- 4. ENGINEERING STANDARDS & GUARANTEES (Warm Ivory Bento Grid) -->
    <section class="relative py-16 sm:py-24 overflow-hidden">
      <!-- Seamless Blueprint Dot-Grid Texture -->
      <div class="absolute inset-0 texture-blueprint-grid opacity-60 pointer-events-none"></div>
      <div class="absolute top-1/3 right-0 w-[500px] h-[500px] bg-vermilion/5 rounded-full blur-3xl pointer-events-none -mr-48"></div>

      <Container size="large" className="relative z-10">
        <SectionHeading
          client:visible
          tag={t(locale, 'Services.standards.tag')}
          title={t(locale, 'Services.standards.title')}
          subtitle={t(locale, 'Services.standards.subtitle')}
        />

        <EngineeringStandardsBento
          client:visible
          card1={standardsCard1}
          card2={standardsCard2}
          card3={standardsCard3}
          card4={standardsCard4}
        />
      </Container>
    </section>
  </div>
</Layout>
