---
import Layout from '../layouts/Layout.astro';
import { Container } from '../components/ui/Container';
import { Badge } from '../components/ui/Badge';
import { SectionHeading } from '../components/ui/SectionHeading';
import { ScrollReveal } from '../components/effects/ScrollReveal';
import { t, type Locale } from '../i18n/utils';
import {
  Sparkles,
  HeartHandshake,
  Target,
  Eye,
} from 'lucide-react';

const locale: Locale = 'en';
---

<Layout
  title={t(locale, 'About.title')}
  description={t(locale, 'About.storyP1')}
  pageType="profile"
  locale={locale}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: t(locale, 'About.title'), url: '/about' },
  ]}
>
  <div class="flex flex-col gap-24 sm:gap-32 pb-36 sm:pb-44 lg:pb-52">
    <!-- 1. Header (Faded Grid Overlay & Warm Shaded Gradient) -->
    <section class="relative pt-16 sm:pt-20 pb-12 sm:pb-16 overflow-hidden bg-gradient-to-b from-[#FFFDF9] via-ivory to-[#EDE3D2] border-b border-warm-border/60">
      {/* Seamless Faded Background Grid with Ambient Radial Glow */}
      <div class="hero-grid-faded" />
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-vermilion/5 rounded-full blur-3xl pointer-events-none" />

      <Container size="large" className="relative z-10">
        <div class="max-w-3xl">
          <Badge
            variant="vermilion"
            size="md"
            className="mb-4 uppercase tracking-widest text-[11px] font-bold"
          >
            <Sparkles className="w-3.5 h-3.5 text-vermilion" />
            <span>{t(locale, 'About.tag')}</span>
          </Badge>
          <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight text-charcoal leading-[1.12] mb-6">
            {t(locale, 'About.title')}
          </h1>
        </div>
      </Container>
    </section>

    <!-- 2. Philosophy / Story -->
    <section>
      <Container size="large">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5">
            <span class="text-xs uppercase font-display font-bold tracking-widest text-vermilion mb-2 block">
              {t(locale, 'About.storyTitle')}
            </span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold text-charcoal leading-tight">
              Software built with intent, beauty, and scale.
            </h2>
          </div>

          <div class="lg:col-span-7 flex flex-col gap-6 text-base sm:text-lg text-charcoal-muted leading-relaxed">
            <p>{t(locale, 'About.storyP1')}</p>
            <p>{t(locale, 'About.storyP2')}</p>
          </div>
        </div>
      </Container>
    </section>

    <!-- 3. Core Values / Pillars -->
    <section class="py-12 bg-charcoal text-ivory">
      <Container size="large">
        <SectionHeading
          client:visible
          tag={t(locale, 'About.values.tag')}
          title="The three pillars that guide every line of code"
          dark
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <ScrollReveal client:visible variant="fade-up" delay={0.1}>
            <div class="flex flex-col gap-4 p-8 rounded-3xl bg-charcoal-800 border border-charcoal-500/30 h-full">
              <div class="w-12 h-12 rounded-2xl bg-vermilion text-ivory flex items-center justify-center font-display font-bold">
                <Eye className="w-6 h-6" />
              </div>
              <h3 class="font-display text-2xl font-bold text-ivory">
                {t(locale, 'About.values.v1Title')}
              </h3>
              <p class="text-sm text-ivory/70 leading-relaxed">
                {t(locale, 'About.values.v1Desc')}
              </p>
            </div>
          </ScrollReveal>

          <ScrollReveal client:visible variant="fade-up" delay={0.25}>
            <div class="flex flex-col gap-4 p-8 rounded-3xl bg-charcoal-800 border border-charcoal-500/30 h-full">
              <div class="w-12 h-12 rounded-2xl bg-vermilion text-ivory flex items-center justify-center font-display font-bold">
                <Target className="w-6 h-6" />
              </div>
              <h3 class="font-display text-2xl font-bold text-ivory">
                {t(locale, 'About.values.v2Title')}
              </h3>
              <p class="text-sm text-ivory/70 leading-relaxed">
                {t(locale, 'About.values.v2Desc')}
              </p>
            </div>
          </ScrollReveal>

          <ScrollReveal client:visible variant="fade-up" delay={0.4}>
            <div class="flex flex-col gap-4 p-8 rounded-3xl bg-charcoal-800 border border-charcoal-500/30 h-full">
              <div class="w-12 h-12 rounded-2xl bg-vermilion text-ivory flex items-center justify-center font-display font-bold">
                <HeartHandshake className="w-6 h-6" />
              </div>
              <h3 class="font-display text-2xl font-bold text-ivory">
                {t(locale, 'About.values.v3Title')}
              </h3>
              <p class="text-sm text-ivory/70 leading-relaxed">
                {t(locale, 'About.values.v3Desc')}
              </p>
            </div>
          </ScrollReveal>
        </div>
      </Container>
    </section>
  </div>
</Layout>
