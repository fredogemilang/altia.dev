---
import type { BreadcrumbItem } from '../../types/seo';
import { ChevronRight, Home } from 'lucide-react';

interface Props {
  items: BreadcrumbItem[];
  className?: string;
}

const { items, className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`flex items-center text-xs font-mono ${className}`}>
  <ol class="flex flex-wrap items-center gap-1.5 text-charcoal-muted" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li
          class="flex items-center gap-1.5"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
        >
          {index === 0 ? (
            <a
              href={item.url}
              class="flex items-center gap-1 hover:text-vermilion transition-colors"
              itemprop="item"
            >
              <Home className="w-3.5 h-3.5" />
              <span itemprop="name" class="sr-only sm:not-sr-only">{item.name}</span>
            </a>
          ) : isLast ? (
            <span
              class="text-charcoal font-bold truncate max-w-[200px] sm:max-w-[320px] md:max-w-md"
              itemprop="name"
              aria-current="page"
            >
              {item.name}
            </span>
          ) : (
            <a
              href={item.url}
              class="hover:text-vermilion transition-colors"
              itemprop="item"
            >
              <span itemprop="name">{item.name}</span>
            </a>
          )}
          <meta itemprop="position" content={(index + 1).toString()} />
          {!isLast && (
            <ChevronRight className="w-3 h-3 text-charcoal-muted/50 flex-shrink-0" />
          )}
        </li>
      );
    })}
  </ol>
</nav>
