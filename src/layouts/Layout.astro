---
import { SITE_CONFIG } from '../lib/constants';
import { Navbar } from '../components/layout/Navbar';
import { Footer } from '../components/layout/Footer';
import { MagneticCursor } from '../components/effects/MagneticCursor';
import { FloatingBackToTop } from '../components/ui/FloatingBackToTop';
import { type Locale, getLocaleFromUrl } from '../i18n/utils';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  locale?: Locale;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  ogImage = SITE_CONFIG.ogImage,
} = Astro.props;

const url = Astro.url;
const locale = Astro.props.locale || getLocaleFromUrl(url);
const pathname = url.pathname;
const fullTitle = title.includes('ALTIA DEV') ? title : `${title} | ALTIA DEV`;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFF6E8" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Web Development, Mobile Apps, Desktop Apps, AI Automation, Astro, GSAP, Creative Agency, ALTIA DEV" />
    <meta name="author" content="ALTIA DEV" />

    <!-- Canonical & Language Alternates -->
    <link rel="canonical" href={url.href} />
    {(() => {
      const basePath = pathname.replace(/^\/id/, '') || '/';
      return (
        <>
          <link rel="alternate" hreflang="en" href={`${SITE_CONFIG.url}${basePath}`} />
          <link rel="alternate" hreflang="id" href={`${SITE_CONFIG.url}/id${basePath === '/' ? '' : basePath}`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE_CONFIG.url}${basePath}`} />
        </>
      );
    })()}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@altiadev" />
  </head>
  <body class="bg-ivory text-charcoal font-sans min-h-screen flex flex-col selection:bg-vermilion selection:text-ivory">
    <MagneticCursor client:idle />
    <Navbar client:load locale={locale} pathname={pathname} />

    <main class="flex-1 pt-20 pb-16 sm:pb-20 lg:pb-24 flex flex-col">
      <slot />
    </main>

    <Footer locale={locale} />
    <FloatingBackToTop client:idle />

    <!-- High-Performance Lenis Smooth Scroll Script synced with GSAP -->
    <script>
      import Lenis from 'lenis';
      import { gsap, ScrollTrigger } from '../lib/gsapConfig';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1.0,
          touchMultiplier: 1.5,
        });

        // Expose lenis instance globally for smooth programmatic scrolling
        (window as any).__lenis = lenis;

        // Sync Lenis scroll updates with GSAP ScrollTrigger
        lenis.on('scroll', ScrollTrigger.update);

        // Sync requestAnimationFrame ticker with GSAP ticker loop
        const updateTicker = (time: number) => {
          lenis.raf(time * 1000);
        };

        gsap.ticker.add(updateTicker);
        gsap.ticker.lagSmoothing(0);
      }
    </script>
  </body>
</html>
