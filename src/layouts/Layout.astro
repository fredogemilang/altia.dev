---
import { SITE_CONFIG } from '../lib/constants';
import SEO from '../components/seo/SEO.astro';
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro';
import { Navbar } from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import { MagneticCursor } from '../components/effects/MagneticCursor';
import { FloatingBackToTop } from '../components/ui/FloatingBackToTop';
import { type Locale, getLocaleFromUrl } from '../i18n/utils';
import type {
  SEOProps,
  BreadcrumbItem,
  ArticleMetadata,
  FAQItem,
  ServiceMetadata,
  CaseStudyMetadata,
  PageType,
} from '../types/seo';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  locale?: Locale;
  pageType?: PageType;
  noindex?: boolean;
  nofollow?: boolean;
  alternateUrls?: { en: string; id: string };
  breadcrumbs?: BreadcrumbItem[];
  article?: ArticleMetadata;
  faqs?: FAQItem[];
  services?: ServiceMetadata[];
  caseStudy?: CaseStudyMetadata;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  canonicalUrl,
  ogImage = SITE_CONFIG.ogImage,
  ogImageAlt,
  pageType = 'website',
  noindex = false,
  nofollow = false,
  alternateUrls,
  breadcrumbs,
  article,
  faqs,
  services,
  caseStudy,
} = Astro.props;

const url = Astro.url;
const locale = Astro.props.locale || getLocaleFromUrl(url);
const pathname = url.pathname;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFF6E8" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Master SEO, GEO & Schema.org Graph Engine -->
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      locale={locale}
      pageType={pageType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      noindex={noindex}
      nofollow={nofollow}
      alternateUrls={alternateUrls}
      breadcrumbs={breadcrumbs}
      article={article}
      faqs={faqs}
      services={services}
      caseStudy={caseStudy}
    />

    <!-- Google Analytics / Google Tag Manager -->
    <GoogleAnalytics />
  </head>
  <body class="bg-ivory text-charcoal font-sans min-h-screen flex flex-col selection:bg-vermilion selection:text-ivory">
    <MagneticCursor client:idle />
    <Navbar client:load locale={locale} pathname={pathname} alternateUrls={alternateUrls} />

    <main class="flex-1 pt-20 pb-16 sm:pb-20 lg:pb-24 flex flex-col">
      <slot />
    </main>

    <Footer locale={locale} />
    <FloatingBackToTop client:idle />

    <!-- High-Performance Lenis Smooth Scroll Script synced with GSAP -->
    <script>
      import Lenis from 'lenis';
      import { gsap, ScrollTrigger } from '../lib/gsapConfig';

      let lastScrollY = window.scrollY || 0;
      let isVisible = true;

      const updateNavbar = (scrollY: number) => {
        const nav = document.getElementById('main-navbar');
        if (!nav) return;

        // Scrolled background style
        if (scrollY > 20) {
          nav.classList.add('navbar-scrolled');
          nav.setAttribute('data-scrolled', 'true');
        } else {
          nav.classList.remove('navbar-scrolled');
          nav.removeAttribute('data-scrolled');
        }

        // Smart sticky auto-hide logic
        const delta = scrollY - lastScrollY;
        const scrollThreshold = 8;

        if (scrollY <= 60) {
          // Always visible at the top
          isVisible = true;
          nav.classList.remove('-translate-y-full', 'pointer-events-none');
          nav.classList.add('translate-y-0');
          nav.setAttribute('data-visible', 'true');
        } else if (delta > scrollThreshold && isVisible) {
          // Scrolling down -> hide navbar
          isVisible = false;
          nav.classList.remove('translate-y-0');
          nav.classList.add('-translate-y-full', 'pointer-events-none');
          nav.setAttribute('data-visible', 'false');
        } else if (delta < -scrollThreshold && !isVisible) {
          // Scrolling up -> show navbar
          isVisible = true;
          nav.classList.remove('-translate-y-full', 'pointer-events-none');
          nav.classList.add('translate-y-0');
          nav.setAttribute('data-visible', 'true');
        }

        lastScrollY = scrollY;
      };

      // Native scroll listener for instant feedback
      const onScroll = () => {
        const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
        updateNavbar(scrollY);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1.0,
          touchMultiplier: 1.5,
        });

        // Expose lenis instance globally for smooth programmatic scrolling
        (window as any).__lenis = lenis;

        // Sync Lenis scroll updates with GSAP ScrollTrigger and Navbar
        lenis.on('scroll', (e: any) => {
          ScrollTrigger.update();
          updateNavbar(e.scroll || window.scrollY || 0);
        });

        // Sync requestAnimationFrame ticker with GSAP ticker loop
        const updateTicker = (time: number) => {
          lenis.raf(time * 1000);
        };

        gsap.ticker.add(updateTicker);
        gsap.ticker.lagSmoothing(0);
      }
    </script>
  </body>
</html>
