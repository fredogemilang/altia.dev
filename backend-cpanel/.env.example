APP_NAME="ALTIA DEV Backend"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_ARTISAN
APP_DEBUG=false
APP_URL=https://serv.altiadev.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=altia_b10cks
DB_USERNAME=altia_user
DB_PASSWORD=your_secure_password_here

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Brevo (Sendinblue) Transactional Email API
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=hello@altiadev.com
BREVO_SENDER_NAME="ALTIA DEV Studio"
CONTACT_RECEIVER_EMAIL=hello@altiadev.com

# CORS Configuration
CORS_ALLOWED_ORIGINS="https://altiadev.com,https://www.altiadev.com,http://localhost:4321"
